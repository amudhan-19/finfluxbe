# FinFlux Backend - Environment Variables
# Copy this file to .env and fill in your values

# -- MySQL Database ---------------------------------------------------------
DB_HOST=finflux-mysql-srv.mysql.database.azure.com
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tricky%40321
DB_NAME=finflux

# -- App --------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development

# -- CORS - React dev server ------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# -- Auth / JWT -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string-min-64-chars-please
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
INVITE_TTL_HOURS=48
RESET_TTL_HOURS=4

# -- Cookie behaviour (dev: SameSite=Lax across same-origin via Vite proxy) -
COOKIE_SECURE=false
COOKIE_DOMAIN=

# -- Bootstrap Admin (created by `python -m scripts.seed`) ------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Admin

# -- ERP credential encryption -----------------------------------------------
# Used to encrypt Business Central / ERP credentials in api_credentials and
# bc_credentials. MUST be stable across restarts: changing the key makes
# existing encrypted credentials unreadable (decrypt -> INVALID_CONFIG, the
# admin must re-enter and save credentials).
#
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Preferred (BC + future connectors):
CREDENTIAL_ENCRYPTION_KEY=
# Legacy fallback (older ERP rows). Leave empty if you only use the key above.
FERNET_KEY=
# Local-only escape hatch. When true AND APP_ENV=development AND no key is
# configured, the backend mints an ephemeral key. Stored credentials will
# break after every restart. Never enable this in production.
ALLOW_EPHEMERAL_DEV_KEY=false

# -- Email (Office 365 / Outlook SMTP) --------------------------------------
# For Microsoft 365, SMTP_FROM must match SMTP_USER unless Send-As is granted
# in the tenant admin. Example: both contact@yourcompany.com
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=FinFlux
SMTP_USE_TLS=true
APP_URL=http://localhost:5173

# -- SLM / PHI-4 chat gateway (server-side only) ----------------------------
# Used by Flux AI commentary generation. The frontend MUST NEVER see the
# API key - every SLM call goes through the FinFlux backend. Leaving these
# blank disables AI commentary generation gracefully (the endpoint returns
# SLM_CONFIG_MISSING; the rest of the app keeps working).
SLM_CHAT_URL=https://llm.tickandtie.com/api/v1/chat
SLM_CHAT_API_KEY=95220024b468356852f41e4e085277c3
SLM_CHAT_PROJECT_ID=3fa85f64-5717-4562-b3fc-2c963f66afa6
SLM_CHAT_TEMPLATE_ID=b74937de-3988-4778-8ea4-c3c58722d5d4
SLM_CHAT_TIMEOUT_SECONDS=30
# 0 = omit max_tokens from the request (let the gateway use its default).
SLM_CHAT_MAX_OUTPUT_TOKENS=0
SLM_CHAT_CONCURRENCY=4

# -- Business Central automated sync (server-side scheduler) -----------------
# When enabled, the backend will sync GL accounts, dimensions, and GL entries
# for every eligible BC-mapped entity on the configured cron, then trigger
# Generate-Flux-from-BC for entities that have ontology mappings. The
# scheduler runs in the same uvicorn process via APScheduler - no Celery /
# Redis. With multiple uvicorn workers, set BC_AUTO_SYNC_ENABLED on exactly
# one of them.
BC_AUTO_SYNC_ENABLED=false
BC_AUTO_SYNC_CRON=0 2 * * *
BC_AUTO_SYNC_TIMEZONE=Asia/Kolkata
BC_AUTO_SYNC_MAX_ENTITIES_PER_RUN=20
BC_AUTO_SYNC_LOCK_MINUTES=60
BC_AUTO_SYNC_INCREMENTAL_DAYS=7

# -- QuickBooks Online OAuth (Intuit app - optional local dev defaults) ------
# Primary source of truth is per-entity credentials saved in Admin Integrations.
# These env vars are optional fallbacks for local development only.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_SCOPES=com.intuit.quickbooks.accounting
QUICKBOOKS_AUTH_URL=https://appcenter.intuit.com/connect/oauth2
QUICKBOOKS_TOKEN_URL=https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer
QUICKBOOKS_API_BASE_SANDBOX=https://sandbox-quickbooks.api.intuit.com
QUICKBOOKS_API_BASE_PRODUCTION=https://quickbooks.api.intuit.com
